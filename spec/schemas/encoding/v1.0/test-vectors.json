  "validation": [
    {
      "name": "over-length-field-rejected",
      "description": "A variable-length field longer than max_field_length MUST be rejected by encoders, never wrapped or truncated.",
      "max_field_length": 4294967295,
      "must_reject": true
    },
    {
      "name": "malformed-currency-rejected",
      "description": "The currency field's internal layout is fixed by its tag byte. An encoder MUST reject a field that does not match the layout its tag fixes, never truncating, padding, or otherwise repairing it.",
      "structure": "payment_commitment",
      "field": "currency",
      "cardano_policy_id_width": 28,
      "cardano_max_asset_name_length": 32,
      "must_reject": [
        {
          "name": "empty-currency",
          "reason": "no tag byte, so no layout is determined",
          "currency_hex": "",
          "rejected": true
        },
        {
          "name": "unregistered-tag",
          "reason": "tag 0x05 is not in the currency registry",
          "currency_hex": "05",
          "rejected": true
        },
        {
          "name": "tag-only-currency-with-trailing-bytes",
          "reason": "sats is the tag byte alone; trailing bytes are not part of its layout",
          "currency_hex": "01ff",
          "rejected": true
        },
        {
          "name": "cardano-native-policy-id-too-short",
          "reason": "minting policy id must be exactly 28 bytes, here 27",
          "currency_hex": "04aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "rejected": true
        },
        {
          "name": "cardano-native-asset-name-too-long",
          "reason": "asset name must be at most 32 bytes, here 33",
          "currency_hex": "04aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa6e6e6e6e6e6e6e6e6e6e6e6e6e6e6e6e6e6e6e6e6e6e6e6e6e6e6e6e6e6e6e6e6e",
          "rejected": true
        }
      ]
    },
    {
      "name": "text-field-encoding",
      "description": "A text field is the UTF-8 bytes of the value as given: no byte-order mark and no Unicode normalisation. An encoder MUST reject a value that is not well-formed Unicode or that begins with U+FEFF, never replacing or stripping anything; a decoder MUST reject field bytes that are not well-formed UTF-8 or that begin with the byte-order mark. Equivalent-looking values that differ in code points are different values; see the did-authorization-purpose-nfc and -nfd vectors. Rejected text values are given as code points (U+XXXX) and rejected bytes as hex.",
      "encoding": "utf-8",
      "byte_order_mark": "never emitted; a value beginning with U+FEFF is rejected",
      "normalisation": "none; bytes are compared as given",
      "must_reject": [
        {
          "name": "leading-bom",
          "code_points": [
            "U+FEFF",
            "U+0063",
            "U+0061",
            "U+0066",
            "U+00E9"
          ],
          "reason": "a leading U+FEFF cannot be told apart from a byte-order mark"
        },
        {
          "name": "lone-surrogate",
          "code_points": [
            "U+0063",
            "U+0061",
            "U+0066",
            "U+D800"
          ],
          "reason": "a lone surrogate is not a Unicode scalar value and has no UTF-8 form"
        },
        {
          "name": "invalid-utf8-sequence",
          "bytes_hex": "636166ff",
          "reason": "0xFF never occurs in well-formed UTF-8"
        },
        {
          "name": "encoded-surrogate",
          "bytes_hex": "636166eda080",
          "reason": "U+D800 encoded as three bytes is not well-formed UTF-8"
        },
        {
          "name": "leading-bom-bytes",
          "bytes_hex": "efbbbf636166c3a9",
          "reason": "the bytes of U+FEFF at the start are a byte-order mark"
        }
      ]
    }
  ]
}
