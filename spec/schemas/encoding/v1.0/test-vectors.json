{
  "version": "1.4",
  "spec": "protocols/preimage-encoding.md",
  "description": "Canonical preimage encoding test vectors. Values are ENCODINGS (hash-agnostic); no hash function is applied. Fixed digest inputs use recognisable placeholder byte patterns.",
  "encoding_rule": {
    "length_prefix": "uint32 big-endian",
    "max_field_length": 4294967295,
    "fixed_width_fields": "emitted raw at schema-pinned width, no prefix",
    "domain_separator": "first field, variable-length, length-prefixed",
    "hash": "NOT specified here; chosen downstream (ADR-005/ADR-007)"
  },
  "domain_separator_registry": {
    "spal/commit/v1": "S-PAL policy commitment (yields policy_content_hash)",
    "spal/pubin/v2": "S-PAL zero-knowledge public input",
    "spal/did-envelope/v1": "DID-signed request envelope",
    "spal/did-authorization/v1": "DID authorization record (ephemeral DID to root DID)",
    "spal/payment/v2": "payment commitment (nested in spal-pubin)"
  },
  "retired_domain_separators": {
    "spal/pubin/v1": "reserved; superseded by v2 as PCI/spal-pubin/v1 (added spend_ref_hash, renamed policy_hash to policy_content_hash) before any implementation existed",
    "spal/payment/v1": "reserved; superseded by v2 as PCI/spal-payment/v1 (currency became a variable-length chain-settlement field) before any implementation existed",
    "PCI/spal-commit/v1": "renamed to spal/commit/v1 (#55); shipped in freehold-preimage 0.2.0",
    "PCI/spal-pubin/v2": "renamed to spal/pubin/v2 (#55); shipped in freehold-preimage 0.2.0 and contracts 0.2.0",
    "PCI/spal-payment/v2": "renamed to spal/payment/v2 (#55); shipped in freehold-preimage 0.2.0 and contracts 0.2.0",
    "PCI/did-envelope/v1": "renamed to spal/did-envelope/v1 (#55); shipped in the 0.2.0 releases of freehold-preimage and freehold-agent"
  },
