                    "accredited": true,
                    "reveal_institution": false,
                    "reveal_year": false
                  }
                }
              ],
              "retention": {
                "max_seconds": 86400,
                "audit_log": true
              },
              "derivatives": {
                "training": "forbidden",
                "aggregation": "forbidden",
                "resale": "forbidden"
              },
              "payment": {
                "protocol": "x402",
                "amount": 500,
                "currency": "sats"
              }
            }
          },
          {
            "id": "rule-experience-verification",
            "context_scope": "professional/work_history",
            "conditions": {
              "identity": {
                "type": "ephemeral_required",
                "linkage": "forbidden"
              },
              "proofs": [
                {
                  "type": "zkp",
                  "claim": "years_experience",
                  "params": {
                    "field": "query",
                    "min_years": "query",
                    "reveal_employers": false,
                    "reveal_exact_years": false
                  }
                }
              ],
              "retention": {
                "max_seconds": 86400,
                "audit_log": true
              },
              "derivatives": {
                "training": "forbidden",
                "aggregation": "forbidden",
                "resale": "forbidden"
              },
              "payment": {
                "protocol": "x402",
                "amount": 500,
                "currency": "sats"
              }
            }
          },
          {
