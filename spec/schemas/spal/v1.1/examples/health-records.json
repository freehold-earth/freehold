{
  "version": "1.1",
  "id": "spal:did:key:z6Mkowner123:health-records",
  "name": "Health Records Access Policy",
  "description": "Controls access to medical and health-related data with strict privacy requirements",
  "created": "2025-01-01T00:00:00Z",
  "owner": "did:key:z6Mkowner123",
  "rules": [
    {
      "id": "rule-diagnosis",
      "context_scope": "medical/diagnosis_codes",
      "conditions": {
        "identity": {
          "type": "ephemeral_required",
          "linkage": "forbidden"
        },
        "proofs": [
          {
            "type": "zkp",
            "claim": "is_licensed_provider",
            "params": {
              "license_type": [
                "MD",
                "DO",
                "NP",
                "PA"
              ],
              "jurisdiction": "any"
            }
          }
        ],
        "retention": {
          "max_seconds": 0,
          "audit_log": true
        },
        "derivatives": {
          "training": "forbidden",
          "aggregation": "forbidden",
          "resale": "forbidden"
        },
        "custody": {
          "operator": "device_only"
        }
      }
    },
    {
      "id": "rule-vaccination-status",
      "context_scope": "medical/immunization/status",
      "conditions": {
        "identity": {
          "type": "ephemeral_required",
          "linkage": "forbidden"
        },
        "proofs": [
          {
            "type": "zkp",
            "claim": "has_vaccination",
            "params": {
              "vaccine_type": "any",
              "reveal_details": false
            }
          }
        ],
        "retention": {
          "max_seconds": 3600,
          "audit_log": true
        },
        "derivatives": {
          "training": "forbidden",
          "aggregation": "anonymized_only",
          "resale": "forbidden"
        },
        "payment": {
          "protocol": "x402",
          "amount": 100,
          "currency": "sats"
        },
        "custody": {
          "operator": "federated_operator"
        }
      }
    },
    {
      "id": "rule-allergies",
      "context_scope": "medical/allergies",
      "conditions": {
        "identity": {
          "type": "ephemeral_required",
          "linkage": "forbidden"
        },
        "proofs": [
          {
            "type": "zkp",
            "claim": "has_allergy",
            "params": {
              "allergen_class": "query",
              "reveal_specific": false
            }
          }
        ],
        "retention": {
          "max_seconds": 0,
          "audit_log": true
        },
        "derivatives": {
          "training": "forbidden",
          "aggregation": "forbidden",
          "resale": "forbidden"
        }
      }
    }
  ],
  "enforcement": {
    "smart_contract": "addr1_contract_health_v1",
    "validators": [
      "cardano",
      "midnight"
    ],
    "dispute_resolution": "dao:freehold:health-wg"
  }
}
