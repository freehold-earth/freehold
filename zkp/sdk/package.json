{
  "name": "@freehold-earth/zkp-sdk",
  "homepage": "https://freehold.earth",
  "version": "0.4.0",
  "description": "TypeScript SDK for Freehold zero-knowledge proofs using Midnight",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "compact": "compactc src/contracts/age-verification.compact --output dist/contracts"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "3.0.0",
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnight-ntwrk/midnight-js-contracts": "5.0.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-types": "5.0.0",
    "@midnightntwrk/onchain-runtime-v4": "4.0.0",
    "@midnightntwrk/wallet-sdk": "2.0.0",
    "memory-level": "3.1.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^9.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freehold-earth/freehold.git"
  },
  "keywords": [
    "pci",
    "zkp",
    "zero-knowledge",
    "midnight",
    "privacy",
    "age-verification"
  ]
}
